# ==============================================================================
# MusicMatch Environment Configuration (Cloud & Serverless Edition)
# ==============================================================================
# In local development: Copy this file to .env in this directory (backend/.env)
# In Vercel: Add these variables under Project Settings -> Environment Variables.

# -- Supabase Cloud Database (PostgreSQL) --------------------------------------
# 1. Sign up at https://supabase.com and create a project
# 2. Go to Project Settings -> API
# 3. Copy Project URL and the "service_role" secret key (bypasses RLS for backend)
# IMPORTANT: Run supabase_migration.sql in the Supabase SQL Editor first!
SUPABASE_URL=https://fgnjwyprvsxmqovtgxkp.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here

# -- JWT Authentication Secret -------------------------------------------------
# Used to sign and verify user authentication tokens
JWT_SECRET=be6b8b196aced709e27d82bcbdf0956456857f4d6a831388a52e16284d69df81
# -- CORS Origins (Frontend Domains) -------------------------------------------
# Comma-separated list of allowed frontend URLs (e.g. your Netlify site)
# Leave empty to automatically allow *.netlify.app and localhost
# Or set to * for open development
CORS_ORIGINS=*

# -- Spotify Web API (Optional) ------------------------------------------------
# Optional: Enables real-time Spotify acoustic search & album artwork matching
# Get from: https://developer.spotify.com/dashboard
# Set redirect URI to: http://127.0.0.1:5000/api/health
SPOTIFY_CLIENT_ID=ca3d70ae4685402fb5b37b10b24f7775
SPOTIFY_CLIENT_SECRET=e4bbf25c0a7041458e29accf51757783
